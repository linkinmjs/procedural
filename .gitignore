# Godot 4+ specific ignores
.godot/
/android/

# Exports locales (el pipeline los genera en CI)
/builds/*
!/builds/.gitkeep

# Assets crudos descargados (zips, proyectos de Reaper: no se versionan).
# El .gdignore si se versiona: le dice a Godot que no importe nada de ahi.
/assets/_raw/*
!/assets/_raw/.gdignore

# Pack local de fuentes (~1200 archivos): solo se versionan las elegidas,
# copiadas a assets/fonts/hud/ y assets/fonts/boot/. Los .gdignore dentro del
# pack le dicen a Godot que tampoco las importe.
/assets/fonts/*/
!/assets/fonts/hud/
!/assets/fonts/boot/

# Referencias en PDF (libros): material local, no se versiona.
/docs/pdfs/
