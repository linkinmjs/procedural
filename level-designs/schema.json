{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procedural-map.local/schemas/level-design-v1.json",
  "title": "Procedural Map level design",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "gridSize", "rooms", "connections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "gridSize": { "type": "number", "exclusiveMinimum": 0 },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "wall": { "enum": ["north", "east", "south", "west"] },
    "block": {
      "type": "object",
      "required": ["enabled", "targetCount", "movement"],
      "properties": {
        "enabled": { "type": "boolean" },
        "targetCount": { "type": "integer", "minimum": 0, "maximum": 24 },
        "movement": { "enum": ["static", "opposite"] }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": ["id", "name", "type", "position", "size", "entry", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["small", "large", "corridor", "custom"] },
        "position": {
          "type": "object",
          "required": ["x", "z"],
          "properties": { "x": { "type": "number" }, "z": { "type": "number" } },
          "additionalProperties": false
        },
        "size": {
          "type": "object",
          "required": ["width", "depth"],
          "properties": {
            "width": { "type": "number", "minimum": 4, "maximum": 40 },
            "depth": { "type": "number", "minimum": 4, "maximum": 40 }
          },
          "additionalProperties": false
        },
        "entry": {
          "type": "object",
          "required": ["wall", "offset"],
          "properties": { "wall": { "$ref": "#/$defs/wall" }, "offset": { "type": "number" } },
          "additionalProperties": false
        },
        "blocks": {
          "type": "object",
          "required": ["left", "front", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/block" },
            "front": { "$ref": "#/$defs/block" },
            "right": { "$ref": "#/$defs/block" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": ["id", "fromRoomId", "toRoomId", "fromWall", "toWall"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromRoomId": { "type": "string", "minLength": 1 },
        "toRoomId": { "type": "string", "minLength": 1 },
        "fromWall": { "$ref": "#/$defs/wall" },
        "toWall": { "$ref": "#/$defs/wall" }
      },
      "additionalProperties": false
    }
  }
}
