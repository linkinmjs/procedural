; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="procedural-map"
run/main_scene="res://scenes/dungeon_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/SimpleDungeons/plugin.cfg")

[global_group]

World=""

[input]

left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
walk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
lean_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
lean_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
WeaponUp={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
WeaponDown={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
Shoot={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
Secondary_Fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
Reload={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
Drop_Weapon={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
Melee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Pickups"
3d_physics/layer_4="Weapons"
3d_physics/layer_5="Rigid Body Projectiles"
3d_physics/layer_6="Targets"

[rendering]

rendering_device/driver.windows="d3d12"
